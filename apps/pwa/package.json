{
  "name": "@malink/pwa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/check-unresolved-names.mts && vite build && tsx scripts/check-static-build.mts",
    "build:official": "MALINK_PWA_BASE_PATH=/malink/ pnpm run build",
    "build:root": "MALINK_PWA_BASE_PATH=/ pnpm run build",
    "start": "vite preview",
    "test": "pnpm run build && tsx --test tests/*.test.*",
    "lint": "eslint . --ignore-pattern dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "@malink/native-bridge": "file:../../packages/native-bridge",
    "@malink/protocol": "file:../../packages/protocol",
    "@malink/security": "file:../../packages/security",
    "jsqr": "1.4.0",
    "matrix-js-sdk": "41.0.0",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "refractor": "5.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.0.13"
  },
  "type": "module"
}
