	handle_path /native-updates/releases/* {
		root * /srv/malink-native-updates/releases
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle_path /native-updates/channels/* {
		root * /srv/malink-native-updates/channels
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		file_server
	}
