	# Malink Gateway Agent updates
	handle /gateway-agent-updates/latest.json {
		root * /srv/malink-gateway-agent-updates
		rewrite * /latest.json
		header Cache-Control "no-store"
		file_server
	}

	handle_path /gateway-agent-updates/channels/* {
		root * /srv/malink-gateway-agent-updates
		header Cache-Control "no-store"
		file_server
	}

	handle_path /gateway-agent-updates/* {
		root * /srv/malink-gateway-agent-updates
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
