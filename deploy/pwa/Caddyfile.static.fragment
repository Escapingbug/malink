	# Malink static PWA
	root * /srv/malink-pwa/current

	@malink_mutable path / /index.html /404.html /version.json /sw.js /manifest.webmanifest
	header @malink_mutable Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
	@malink_navigation header Accept *text/html*
	header @malink_navigation Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	try_files {path} {path}/ /index.html
	file_server
